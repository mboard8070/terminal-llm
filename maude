#!/bin/bash
# MAUDE - Multi-Agent Unified Dispatch Engine
# Services managed by systemd user units (maude.target).
#
# Usage:
#   maude              Start services + open TUI
#   maude stop         Stop all services
#   maude status       Health check
#   maude restart      Bounce all services
#   maude log [name]   Tail service logs (default: gateway)

DIR=/home/mboard76/nvidia-workbench/terminal-llm
VENV="$DIR/venv/bin/python"
SERVICES=(nemo gateway voice fileserver watcher)

case "${1:-}" in
    stop)
        echo "Stopping MAUDE..."
        systemctl --user stop maude.target
        echo "Done."
        ;;

    status)
        systemctl --user status maude-* --no-pager 2>/dev/null
        echo ""
        echo "Ports:"
        ss -tlnp 2>/dev/null | grep -E '30010|8998|30000|30080|30002' | awk '{print "  "$4}'
        ;;

    restart)
        echo "Restarting MAUDE..."
        for svc in "${SERVICES[@]}"; do
            systemctl --user restart "maude-${svc}.service"
        done
        echo "Done."
        ;;

    log)
        svc="${2:-gateway}"
        journalctl --user -u "maude-${svc}" -f --no-hostname
        ;;

    *)
        # Start services if not already running
        systemctl --user start maude.target

        # Wait for gateway to be ready
        printf "Waiting for gateway..."
        for i in $(seq 1 30); do
            curl -s http://localhost:30080/v1/models > /dev/null 2>&1 && break
            printf "."
            sleep 1
        done
        if curl -s http://localhost:30080/v1/models > /dev/null 2>&1; then
            echo " ready"
        else
            echo " timeout (check: maude log gateway)"
        fi

        # TUI in foreground
        cd "$DIR" && exec $VENV chat_lite.py
        ;;
esac
